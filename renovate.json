{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 17-23 * * 5"
  ],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "flux": {
    "managerFilePatterns": [
      "/(^|/)cluster/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)cluster/.+\\.ya?ml$/"
    ]
  },
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 17-23 * * 5"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.ya?ml$/",
        "/\\.nix$/",
        "/\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.*?[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "description": "CNPG Cluster.spec.imageName (key: repo:tag), not covered by the kubernetes manager",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)cluster/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "imageName:\\s*\"?(?<depName>[^:\\s\"]+):(?<currentValue>[^@\\s\"]+)(@(?<currentDigest>sha256:[a-f0-9]+))?\"?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "flux"
      ],
      "matchPackageNames": [
        "fluxcd/flux2"
      ],
      "groupName": "flux"
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "nix"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "CI action bumps are validated by the CI run on their own PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "ci",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "NixOS channel bumps need manual review",
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "nixpkgs"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "automerge": false,
      "labels": [
        "nixos-release"
      ]
    },
    {
      "description": "apiVersion tracking is noise",
      "matchDatasources": [
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "description": "Pin qbittorrent to digest to also catch linuxserver rebuilds of the same version tag",
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "pinDigests": true
    },
    {
      "description": "Home Assistant chart bumps usually ship a new HA release - review manually",
      "matchManagers": [
        "flux"
      ],
      "matchPackageNames": [
        "home-assistant"
      ],
      "automerge": false
    },
    {
      "description": "Cluster imageName and the backup CronJob image move together (pg_dump must be >= server)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "groupName": "postgresql"
    },
    {
      "description": "PostgreSQL majors are an in-place major upgrade of the CNPG Cluster - approve and review manually",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
